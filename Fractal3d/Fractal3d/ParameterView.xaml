<UserControl x:Class="Fractal3d.ParameterView"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                 xmlns:local="clr-namespace:Fractal3d"
                 xmlns:basicWpfLibrary="clr-namespace:BasicWpfLibrary;assembly=BasicWpfLibrary"
                 mc:Ignorable="d" d:DesignWidth="800"
                 d:DataContext="{d:DesignInstance Type=local:ParameterVm}"
                 basicWpfLibrary:UserControlBehavior.IsVisibleChangedCommand="{Binding IsVisibleChangedCommand}" >
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="GeneralResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Width="420" Height="670" Style="{StaticResource BorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="2,5" Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Margin="2" >
                    <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="Image Width" />
                    <TextBox Style="{StaticResource TextBoxInError}" >
                        <TextBox.Text>
                            <Binding Path="ImageWidth" 
                                     UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <basicWpfLibrary:IntRangeRule Min="{x:Static local:ParameterConstants.MinImage}" 
                                                                  Max="{x:Static local:ParameterConstants.MaxImage}"/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="20,2,2,2">
                    <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="Image Height" />
                    <TextBox Style="{StaticResource TextBoxInError}">
                        <TextBox.Text>
                            <Binding Path="ImageHeight" 
                                     UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <basicWpfLibrary:IntRangeRule Min="{x:Static local:ParameterConstants.MinImage}" 
                                                                  Max="{x:Static local:ParameterConstants.MaxImage}"/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="2,5" Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Margin="2">
                    <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="Display Width" />
                    <TextBox Style="{StaticResource TextBoxInError}" >
                        <TextBox.Text>
                            <Binding Path="DisplayWidth" 
                                     UpdateSourceTrigger="PropertyChanged" >
                                <Binding.ValidationRules>
                                    <basicWpfLibrary:IntRangeRule Min="{x:Static local:ParameterConstants.MinImage}" 
                                                                  Max="{x:Static local:ParameterConstants.MaxImage}"/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="20,2,2,2">
                    <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="Display Height" />
                    <TextBox Style="{StaticResource TextBoxInError}" >
                        <TextBox.Text>
                            <Binding Path="DisplayHeight" 
                                     UpdateSourceTrigger="PropertyChanged" >
                                <Binding.ValidationRules>
                                    <basicWpfLibrary:IntRangeRule Min="{x:Static local:ParameterConstants.MinImage}" 
                                                                  Max="{x:Static local:ParameterConstants.MaxImage}"/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
            </StackPanel>
            <Grid Grid.Row="2" Margin="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0"  Orientation="Horizontal" Margin="2" HorizontalAlignment="Right">
                    <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="From X" />
                    <TextBox Style="{StaticResource TextBoxInError}"  basicWpfLibrary:TextBoxFocusBehavior.ClearOnFocus="True">
                        <TextBox.Text>
                            <Binding Path="FromX"
                                     UpdateSourceTrigger="LostFocus" >
                                <Binding.ValidationRules>
                                    <basicWpfLibrary:FloatRangeRule Min="{x:Static local:ParameterConstants.MinFromTo}" 
                                                                    Max="{x:Static local:ParameterConstants.MaxFromTo}"/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="2" HorizontalAlignment="Right">
                    <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="From Y" />
                    <TextBox Style="{StaticResource TextBoxInError}" basicWpfLibrary:TextBoxFocusBehavior.ClearOnFocus="True">
                        <TextBox.Text>
                            <Binding Path="FromY" 
                                     UpdateSourceTrigger="LostFocus" >
                                <Binding.ValidationRules>
                                    <basicWpfLibrary:FloatRangeRule Min="{x:Static local:ParameterConstants.MinFromTo}" 
                                                                    Max="{x:Static local:ParameterConstants.MaxFromTo}"/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2"  Orientation="Horizontal" Margin="2" HorizontalAlignment="Right">
                    <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="From Z" />
                    <TextBox Style="{StaticResource TextBoxInError}" basicWpfLibrary:TextBoxFocusBehavior.ClearOnFocus="True">
                        <TextBox.Text>
                            <Binding Path="FromZ" 
                                     UpdateSourceTrigger="LostFocus" >
                                <Binding.ValidationRules>
                                    <basicWpfLibrary:FloatRangeRule Min="{x:Static local:ParameterConstants.MinFromTo}" 
                                                                    Max="{x:Static local:ParameterConstants.MaxFromTo}"/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="2" HorizontalAlignment="Right">
                    <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="To X" />
                    <TextBox Style="{StaticResource TextBoxInError}" basicWpfLibrary:TextBoxFocusBehavior.ClearOnFocus="True">
                        <TextBox.Text>
                            <Binding Path="ToX" 
                                     UpdateSourceTrigger="LostFocus" >
                                <Binding.ValidationRules>
                                    <basicWpfLibrary:FloatRangeRule Min="{x:Static local:ParameterConstants.MinFromTo}" 
                                                                    Max="{x:Static local:ParameterConstants.MaxFromTo}"/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="2" HorizontalAlignment="Right">
                    <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="To Y" />
                    <TextBox Style="{StaticResource TextBoxInError}" basicWpfLibrary:TextBoxFocusBehavior.ClearOnFocus="True">
                        <TextBox.Text>
                            <Binding Path="ToY" 
                                     UpdateSourceTrigger="LostFocus" >
                                <Binding.ValidationRules>
                                    <basicWpfLibrary:FloatRangeRule Min="{x:Static local:ParameterConstants.MinFromTo}" 
                                                                    Max="{x:Static local:ParameterConstants.MaxFromTo}"/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="2" HorizontalAlignment="Right">
                    <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="To Z" />
                    <TextBox Style="{StaticResource TextBoxInError}" basicWpfLibrary:TextBoxFocusBehavior.ClearOnFocus="True">
                        <TextBox.Text>
                            <Binding Path="ToZ" 
                                     UpdateSourceTrigger="LostFocus" >
                                <Binding.ValidationRules>
                                    <basicWpfLibrary:FloatRangeRule Min="{x:Static local:ParameterConstants.MinFromTo}" 
                                                                    Max="{x:Static local:ParameterConstants.MaxFromTo}"/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
            </Grid >

            <StackPanel Grid.Row="3" Margin="2" Orientation="Horizontal">
                <CheckBox Margin="5,2" Padding="2" VerticalContentAlignment="Center"
                  IsChecked="{Binding AimToOrigin}">Aim to origin</CheckBox>
            </StackPanel>
            <Separator Grid.Row="4"/>
            <StackPanel Grid.Row="5" Margin="2,5" Orientation="Horizontal" >
                <StackPanel Margin="2" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="Shader Type" />
                    <ComboBox Margin="2" Padding="2" ItemsSource="{Binding AllowedShaderTypes}" SelectedItem="{Binding SelectedShaderType}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="20, 2,2,2" Orientation="Horizontal" Visibility="{Binding IfsVisibility}">
                    <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="IFS Equation Type" />
                    <ComboBox Margin="2" Padding="2" ItemsSource="{Binding AllowedIfsEquationTypes}" SelectedItem="{Binding SelectedIfsEquationType}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="6" Margin="2,5" Orientation="Horizontal" Visibility="{Binding QuatEquationVisibility}">
                <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="Quaterion Equation Type" />
                <ComboBox Margin="2" Padding="2" ItemsSource="{Binding AllowedQuatEquations}" SelectedItem="{Binding SelectedQuatEquationType}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Row="6" Margin="2, 5" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding ShaderSceneTypeVisibility}">
                <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="Shape" />
                <ComboBox Margin="10,2,2,2" Padding="2" VerticalAlignment="Center"
                          ItemsSource="{Binding AllowedSceneTypes}" 
                          SelectedItem="{Binding SelectedSceneType}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Row="7" Margin="2,5" Orientation="Horizontal" Visibility="{Binding ConstantC_Visibility}">
                <StackPanel Margin="2,2,10,2" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="Constant C" />
                </StackPanel>
                <StackPanel Margin="2" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="W:" />
                    <TextBox Style="{StaticResource MinWidthTextBoxStyle}" Text="{Binding Cw}" />
                </StackPanel>
                <StackPanel Margin="2" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="X:" />
                    <TextBox Style="{StaticResource MinWidthTextBoxStyle}" Text="{Binding Cx}" />
                </StackPanel>
                <StackPanel Margin="2" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="Y:" />
                    <TextBox Style="{StaticResource MinWidthTextBoxStyle}" Text="{Binding Cy}" />
                </StackPanel>
                <StackPanel Margin="2" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="Z:" />
                    <TextBox Style="{StaticResource MinWidthTextBoxStyle}" Text="{Binding Cz}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="8" Margin="2,5" Orientation="Horizontal" Visibility="{Binding IfsCenterVisibility}">
                <StackPanel Margin="2,2,10,2" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="IFS C" />
                </StackPanel>
                <StackPanel Margin="2" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="X:" />
                    <TextBox Style="{StaticResource MinWidthTextBoxStyle}" Text="{Binding IfsCx}" />
                </StackPanel>
                <StackPanel Margin="2" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="Y:" />
                    <TextBox Style="{StaticResource MinWidthTextBoxStyle}" Text="{Binding IfsCy}" />
                </StackPanel>
                <StackPanel Margin="2" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="Z:" />
                    <TextBox Style="{StaticResource MinWidthTextBoxStyle}" Text="{Binding IfsCz}" />
                </StackPanel>
                <StackPanel Margin="2" Orientation="Horizontal">
                    <Button Margin="10,2,2,2" Padding="2" Command="{Binding NormalizeIfsCCommand}">Normalize</Button>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="9" Margin="2" Orientation="Horizontal" Visibility="{Binding IfsVisibility}">
                <CheckBox Margin="5,2" Padding="2" VerticalContentAlignment="Center"
                  IsChecked="{Binding IfsAbs}">Ifs Absolute</CheckBox>
            </StackPanel>
            
            <Separator Grid.Row="10"/>
            <StackPanel Grid.Row="11" Margin="2,5" Orientation="Horizontal">
                <StackPanel  Margin="0,0,20,0" Orientation="Horizontal" Visibility="{Binding BailoutVisibility}">
                    <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="Bailout" />
                    <TextBox Style="{StaticResource TextBoxInError}" >
                        <TextBox.Text>
                            <Binding Path="Bailout" 
                                 UpdateSourceTrigger="LostFocus" >
                                <Binding.ValidationRules>
                                    <basicWpfLibrary:FloatRangeRule Min="{x:Static local:ParameterConstants.MinBailout}" 
                                                                Max="{x:Static local:ParameterConstants.MaxBailout}"/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding IfsVisibility}">
                    <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="IFS Scale" />
                    <TextBox Style="{StaticResource TextBoxInError}" >
                        <TextBox.Text>
                            <Binding Path="IfsScale" 
                                 UpdateSourceTrigger="LostFocus" >
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="12" Margin="2,5" Orientation="Horizontal" >
                <StackPanel Margin="0,0,20,0" Orientation="Horizontal" Visibility="{Binding IterationVisibility}">
                    <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="Iterations" />
                    <TextBox Style="{StaticResource TextBoxInError}" >
                        <TextBox.Text>
                            <Binding Path="Iterations" 
                                 UpdateSourceTrigger="LostFocus" >
                                <Binding.ValidationRules>
                                    <basicWpfLibrary:IntRangeRule Min="{x:Static local:ParameterConstants.MinIterations}" 
                                                                Max="{x:Static local:ParameterConstants.MaxIterations}"/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding LSystemVisibility}">
                    <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="L-system Radius" />
                    <TextBox Style="{StaticResource TextBoxInError}" >
                        <TextBox.Text>
                            <Binding Path="LSystemRadius" 
                                 UpdateSourceTrigger="LostFocus" >
                                <Binding.ValidationRules>
                                    <basicWpfLibrary:FloatRangeRule Min="{x:Static local:ParameterConstants.MinLSystemRadius}" 
                                                                Max="{x:Static local:ParameterConstants.MaxLSystemRadius}"/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="13" Margin="2,5" Orientation="Horizontal" >
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="Min Ray Distance" />
                    <TextBox Style="{StaticResource TextBoxInError}" >
                        <TextBox.Text>
                            <Binding Path="MinRayDistance" 
                                     UpdateSourceTrigger="LostFocus" >
                                <Binding.ValidationRules>
                                    <basicWpfLibrary:FloatRangeRule Min="{x:Static local:ParameterConstants.MinMinRayDistance}" 
                                                                    Max="{x:Static local:ParameterConstants.MaxMinRayDistance}"/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" >
                    <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="Max Ray Steps" />
                    <TextBox Style="{StaticResource TextBoxInError}" >
                        <TextBox.Text>
                            <Binding Path="MaxRaySteps" 
                                     UpdateSourceTrigger="LostFocus" >
                                <Binding.ValidationRules>
                                    <basicWpfLibrary:IntRangeRule Min="{x:Static local:ParameterConstants.MinMaxRaySteps}" 
                                                                    Max="{x:Static local:ParameterConstants.MaxMaxRaySteps}"/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="14" Margin="2,5" Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" >
                    <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="Distance" />
                    <TextBox Style="{StaticResource TextBoxInError}" >
                        <TextBox.Text>
                            <Binding Path="Distance" 
                                     UpdateSourceTrigger="LostFocus" >
                                <Binding.ValidationRules>
                                    <basicWpfLibrary:FloatRangeRule Min="{x:Static local:ParameterConstants.MinDistance}" 
                                                                    Max="{x:Static local:ParameterConstants.MaxDistance}"/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                    <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="Max Distance" />
                    <TextBox Style="{StaticResource TextBoxInError}" >
                        <TextBox.Text>
                            <Binding Path="MaxDistance" 
                                     UpdateSourceTrigger="LostFocus" >
                                <Binding.ValidationRules>
                                    <basicWpfLibrary:FloatRangeRule Min="{x:Static local:ParameterConstants.MinDistance}" 
                                                                    Max="{x:Static local:ParameterConstants.MaxDistance}"/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="15" Margin="2, 5" Orientation="Horizontal" Visibility="{Binding RayTraceFieldVisibility}">
                <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="Step Divisor" />
                <TextBox Style="{StaticResource TextBoxInError}" MaxWidth="80">
                    <TextBox.Text>
                        <Binding Path="StepDivisor" 
                                 UpdateSourceTrigger="LostFocus" >
                            <Binding.ValidationRules>
                                <basicWpfLibrary:FloatRangeRule Min="{x:Static local:ParameterConstants.MinStepDivisor}" 
                                                                Max="{x:Static local:ParameterConstants.MaxStepDivisor}"/>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>
            </StackPanel>

            <Separator Grid.Row="16"/>
            <StackPanel Grid.Row="17" Margin="2,5,2,2" Orientation="Horizontal" Visibility="{Binding EscapeThresholdVisibility}">
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0" >
                    <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="Escape Threshold" />
                    <TextBox Style="{StaticResource TextBoxInError}" >
                        <TextBox.Text>
                            <Binding Path="EscapeThreshold" 
                                     UpdateSourceTrigger="LostFocus" >
                                <Binding.ValidationRules>
                                    <basicWpfLibrary:FloatRangeRule Min="{x:Static local:ParameterConstants.MinEscapeThreshold}" 
                                                                    Max="{x:Static local:ParameterConstants.MaxEscapeThreshold}"/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
                <CheckBox VerticalContentAlignment="Center" VerticalAlignment="Center"
                  IsChecked="{Binding RenderShadows}" Visibility="{Binding IsCraneShader, Converter={StaticResource BoolToVisibilityConverterShowOnTrue}, 
                    UpdateSourceTrigger=PropertyChanged}">Shadows</CheckBox>
            </StackPanel>

            <StackPanel Grid.Row="18" Margin="2,5" Orientation="Horizontal" Style="{StaticResource CranePixelStack}">
                <StackPanel Orientation="Horizontal" >
                    <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="Color Base" />
                    <TextBox Style="{StaticResource TextBoxInError}" >
                        <TextBox.Text>
                            <Binding Path="ColorBase" 
                                     UpdateSourceTrigger="LostFocus" >
                                <Binding.ValidationRules>
                                    <basicWpfLibrary:FloatRangeRule Min="{x:Static local:ParameterConstants.MinColorBase}" 
                                                                    Max="{x:Static local:ParameterConstants.MaxColorBase}"/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" >
                    <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="DistanceScale" />
                    <TextBox Style="{StaticResource TextBoxInError}" >
                        <TextBox.Text>
                            <Binding Path="DistanceScale" 
                                     UpdateSourceTrigger="LostFocus" >
                                <Binding.ValidationRules>
                                    <basicWpfLibrary:FloatRangeRule Min="{x:Static local:ParameterConstants.MinDistanceScale}" 
                                                                    Max="{x:Static local:ParameterConstants.MaxDistanceScale}"/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="19" Margin="2,5" Orientation="Horizontal" Visibility="{Binding BackgroundVisibility}">
                <StackPanel Margin="2,2,10,2" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="Background" />
                </StackPanel>
                <StackPanel Margin="2" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="A:" />
                    <TextBox Style="{StaticResource TextBoxInError}" >
                        <TextBox.Text>
                            <Binding Path="BackgroundColorA" 
                                 UpdateSourceTrigger="LostFocus" >
                                <Binding.ValidationRules>
                                    <basicWpfLibrary:IntRangeRule Min="{x:Static local:ParameterConstants.MinColorComponent}" 
                                                                Max="{x:Static local:ParameterConstants.MaxColorComponent}"/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
                <StackPanel Margin="2" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="R:" />
                    <TextBox Style="{StaticResource TextBoxInError}" >
                        <TextBox.Text>
                            <Binding Path="BackgroundColorR" 
                                 UpdateSourceTrigger="LostFocus" >
                                <Binding.ValidationRules>
                                    <basicWpfLibrary:IntRangeRule Min="{x:Static local:ParameterConstants.MinColorComponent}" 
                                                                Max="{x:Static local:ParameterConstants.MaxColorComponent}"/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
                <StackPanel Margin="2" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="G:" />
                    <TextBox Style="{StaticResource TextBoxInError}" >
                        <TextBox.Text>
                            <Binding Path="BackgroundColorG" 
                                 UpdateSourceTrigger="LostFocus" >
                                <Binding.ValidationRules>
                                    <basicWpfLibrary:IntRangeRule Min="{x:Static local:ParameterConstants.MinColorComponent}" 
                                                                Max="{x:Static local:ParameterConstants.MaxColorComponent}"/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
                <StackPanel Margin="2" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="B:" />
                    <TextBox Style="{StaticResource TextBoxInError}" >
                        <TextBox.Text>
                            <Binding Path="BackgroundColorB" 
                                 UpdateSourceTrigger="LostFocus" >
                                <Binding.ValidationRules>
                                    <basicWpfLibrary:IntRangeRule Min="{x:Static local:ParameterConstants.MinColorComponent}" 
                                                                Max="{x:Static local:ParameterConstants.MaxColorComponent}"/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="20" Margin="2, 5" Orientation="Vertical" Visibility="{Binding NonCraneShaderVisibility}">
                <CheckBox Margin="5,0,5,5" Padding="2" VerticalContentAlignment="Center"
                  IsChecked="{Binding LightingOnZeroIndex}">Lighting on zero index</CheckBox>
                <StackPanel Margin="2" Orientation="Horizontal" >
                    <StackPanel Orientation="Horizontal" >
                        <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="Min Stretch Distance" />
                        <TextBox Style="{StaticResource TextBoxInError}" >
                            <TextBox.Text>
                                <Binding Path="MinStretchDistance" 
                                     UpdateSourceTrigger="LostFocus" >
                                    <Binding.ValidationRules>
                                        <basicWpfLibrary:FloatRangeRule Min="{x:Static local:ParameterConstants.MinDistanceStretch}" 
                                                                    Max="{x:Static local:ParameterConstants.MaxDistanceStretch}"/>
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                        <TextBlock Style="{StaticResource PlainTextBlockStyle}" Text="Max Stretch Distance" />
                        <TextBox Style="{StaticResource TextBoxInError}" >
                            <TextBox.Text>
                                <Binding Path="MaxStretchDistance" 
                                     UpdateSourceTrigger="LostFocus" >
                                    <Binding.ValidationRules>
                                        <basicWpfLibrary:FloatRangeRule Min="{x:Static local:ParameterConstants.MinDistanceStretch}" 
                                                                    Max="{x:Static local:ParameterConstants.MaxDistanceStretch}"/>
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="21" Orientation="Vertical">

                <TabControl  Visibility="{Binding IfsVisibility}" Height="200">
                    <TabItem Header="Transform 1" DataContext="{Binding }">
                        <ContentPresenter Content="{Binding Transform1}">
                            <ContentPresenter.Resources>
                                <DataTemplate DataType="{x:Type local:TransformVm2}" >
                                    <local:TransformViewHorizontal/>
                                </DataTemplate>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </TabItem>
                    <TabItem Header="Transform 2" DataContext="{Binding }">
                        <ContentPresenter Content="{Binding Transform2}">
                            <ContentPresenter.Resources>
                                <DataTemplate DataType="{x:Type local:TransformVm2}" >
                                    <local:TransformViewHorizontal/>
                                </DataTemplate>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </TabItem>
                </TabControl>
            </StackPanel>

            <Grid Grid.Row="22" Margin="2,5" Grid.IsSharedSizeScope="True" Visibility="{Binding LSystemVisibility}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Header Row -->
                    <RowDefinition Height="*"/>
                    <!-- Items Rows -->
                </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource HeaderTextBlockStyle}" Text="L-system Branches" />
                        <Button Margin="5,2" Padding="2" MinWidth="30" Command="{Binding AddBranchCommand}">Add</Button>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#F0F0F0" Padding="2" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Column widths adjust dynamically, shared across all grids in this scope -->
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Pos"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Attenuation"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="AngleX"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="AngleY"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="AngleZ"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Position" FontWeight="Bold" Margin="11,2"/>
                            <TextBlock Grid.Column="1" Text="Attenuation" FontWeight="Bold" Margin="11,2"/>
                            <TextBlock Grid.Column="2" Text="Angle X" FontWeight="Bold" Margin="11,2"/>
                            <TextBlock Grid.Column="3" Text="Angle Y" FontWeight="Bold" Margin="11,2"/>
                            <TextBlock Grid.Column="4" Text="Angle Z" FontWeight="Bold" Margin="11,2"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding LSystemBranches}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="2" BorderBrush="#EAEAEA" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Pos"/>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Attenuation"/>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="AngleX"/>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="AngleY"/>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="AngleZ"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Style="{StaticResource TextBoxInError}" Margin="11,2">
                                            <TextBox.Text>
                                                <Binding Path="RelativePositionX" UpdateSourceTrigger="LostFocus" >
                                                    <Binding.ValidationRules>
                                                        <basicWpfLibrary:FloatRangeRule Min="{x:Static local:ParameterConstants.MinLSystemRelativePosition }" 
                                                                    Max="{x:Static local:ParameterConstants.MaxLSystemRelativePosition}"/>
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </TextBox.Text>
                                        </TextBox>
                                        <TextBox Grid.Column="1" Style="{StaticResource TextBoxInError}" Margin="11,2">
                                            <TextBox.Text>
                                                <Binding Path="Attenuation" UpdateSourceTrigger="LostFocus" >
                                                    <Binding.ValidationRules>
                                                        <basicWpfLibrary:FloatRangeRule Min="{x:Static local:ParameterConstants.MinLSystemAttenuation }" 
                                                                    Max="{x:Static local:ParameterConstants.MaxLSystemAttenuation}"/>
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </TextBox.Text>
                                        </TextBox>
                                        <TextBox Grid.Column="2" Style="{StaticResource TextBoxInError}" Margin="11,2">
                                            <TextBox.Text>
                                                <Binding Path="AngleXDegrees" UpdateSourceTrigger="LostFocus" >
                                                    <Binding.ValidationRules>
                                                        <basicWpfLibrary:FloatRangeRule Min="{x:Static local:ParameterConstants.MinLSystemAngle }" 
                                                                    Max="{x:Static local:ParameterConstants.MaxLSystemAngle}"/>
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </TextBox.Text>
                                        </TextBox>
                                        <TextBox Grid.Column="3" Style="{StaticResource TextBoxInError}" Margin="11,2">
                                            <TextBox.Text>
                                                <Binding Path="AngleYDegrees" UpdateSourceTrigger="LostFocus" >
                                                    <Binding.ValidationRules>
                                                        <basicWpfLibrary:FloatRangeRule Min="{x:Static local:ParameterConstants.MinLSystemAngle }" 
                                                                    Max="{x:Static local:ParameterConstants.MaxLSystemAngle}"/>
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </TextBox.Text>
                                        </TextBox>
                                        <TextBox Grid.Column="4" Style="{StaticResource TextBoxInError}" Margin="11,2">
                                            <TextBox.Text>
                                                <Binding Path="AngleZDegrees" UpdateSourceTrigger="LostFocus" >
                                                    <Binding.ValidationRules>
                                                        <basicWpfLibrary:FloatRangeRule Min="{x:Static local:ParameterConstants.MinLSystemAngle }" 
                                                                    Max="{x:Static local:ParameterConstants.MaxLSystemAngle}"/>
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </TextBox.Text>
                                        </TextBox>
                                        <Button Grid.Column="5" Margin="11,2" Content="Delete" Command="{Binding DataContext.DeleteRowCommand, 
                                                RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>

                                    </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

            </Grid>

        </Grid>
    </Border>
</UserControl>
