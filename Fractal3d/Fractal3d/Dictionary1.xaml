<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:util="clr-namespace:QpUtilities"
                    xmlns:Validators="clr-namespace:ValidatorRules"      
                    xmlns:local="clr-namespace:QpIonRatioPage">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="GeneralStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="boolToVisibility" />

    <DataTemplate x:Key="AnalyteIonRatios" DataType="{x:Type local:Analyte}">
        <Grid>
            <Expander Header="{Binding Name}" Style="{StaticResource AnalyteExpander}">
                <i:Interaction.Behaviors>
                    <util:PersistGroupExpandedStateBehavior GroupName="{Binding Name}" />
                </i:Interaction.Behaviors>
                <ItemsControl Name="ionRatios" ItemsSource="{Binding AllIonRatios}" Margin="0" >
                    <ItemsControl.Template>
                        <ControlTemplate>
                            <Border >
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40px" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="18px" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Style="{StaticResource ExpectedRatioEqualSignVisibility}"/>
                                            <ColumnDefinition Style="{StaticResource ExpectedRatioVisibility}"/>
                                            <ColumnDefinition Width="18px" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="18px" />
                                            <ColumnDefinition Style="{StaticResource ActualRatioVisibility}"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Foreground="Green" Command="{Binding Path=AddIonRatioCommand}" 
                                                Style="{StaticResource IonRatioButtonStyle}" 
                                                Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:IonRatioItemsControl}}, Path=ReadOnlyMode, Converter={StaticResource falseToVisibleConverter}}">
                                            <Image Source="Images/Add.png" />
                                        </Button>
                                        <TextBlock Grid.Column="1" Text="m/z 1"  Style="{StaticResource HeaderStyle}" />
                                        <TextBlock Grid.Column="3" Text="m/z 2"  Style="{StaticResource HeaderStyle}" />
                                        <TextBlock Grid.Column="5" Text="Expected Ratio" Style="{StaticResource HeaderStyle}" />
                                        <TextBlock Grid.Column="7" Text="Tolerance" Style="{StaticResource HeaderStyle}" />
                                        <TextBlock Grid.Column="9" Text="Actual Ratio" Style="{StaticResource HeaderStyle}" />
                                    </Grid>
                                    <ItemsPresenter/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid KeyboardNavigation.TabNavigation="Continue">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40px" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18px" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Style="{StaticResource ExpectedRatioEqualSignVisibility}"/>
                                    <ColumnDefinition Style="{StaticResource ExpectedRatioVisibility}"/>
                                    <ColumnDefinition Width="18px" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18px" />
                                    <ColumnDefinition Style="{StaticResource ActualRatioVisibility}"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Command="{Binding Path=RemoveIonRatioCommand}" Style="{StaticResource IonRatioButtonStyle}" 
                                        Visibility="{Binding Path=QualifierCheck, Converter={StaticResource falseToVisibleConverter}}"
                                        IsEnabled="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:IonRatioItemsControl}}, Path=ReadOnlyMode, Converter={StaticResource inverseBoolConverter}}" >
                                    <Image Source="Images/Remove.png"/>
                                </Button>

                                <Label Grid.Column="0" Content="{Binding QualifierIonName}" HorizontalAlignment="Center" VerticalAlignment="Top" Width="20" Height="20" 
                                       HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Padding="1"
				                       Visibility="{Binding Path=QualifierCheck, Converter={StaticResource boolToVisibility}}"/>

                                <ComboBox Grid.Column="1" ItemsSource="{Binding MassSuggestions}"
                                          IsEditable="False" 
                                          SelectedItem="{Binding Mass1}"
                                          IsReadOnly="True">
                                    <ComboBox.IsEnabled>
                                        <MultiBinding Converter="{StaticResource anyBoolToFalseConverter}">
                                            <Binding Path="QualifierCheck" />
                                            <Binding RelativeSource="{RelativeSource AncestorType={x:Type local:IonRatioItemsControl}}" Path="ReadOnlyMode" />
                                        </MultiBinding>
                                    </ComboBox.IsEnabled>
                                    <ComboBox.Text>
                                        <Binding Path="NewMass1" UpdateSourceTrigger="LostFocus">
                                            <Binding.ValidationRules>
                                                <Validators:MassValidationRule />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </ComboBox.Text>
                                    <ComboBox.ToolTip>
                                        <ToolTip>
                                            <ToolTip.Style>
                                                <Style TargetType="ToolTip">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=PlacementTarget.(Validation.HasError)}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Setter Property="Content" Value="{Binding RelativeSource={RelativeSource Self}, Path=PlacementTarget.(Validation.Errors)[0].ErrorContent}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToolTip.Style>
                                        </ToolTip>
                                    </ComboBox.ToolTip>
                                </ComboBox>
                                <TextBlock Grid.Column="2" Text="÷" Style="{StaticResource HeaderStyleCentered}" />
                                <ComboBox Grid.Column="3" ItemsSource="{Binding MassSuggestions}"
                                         IsEditable="False" 
                                          SelectedItem="{Binding Mass2}"
                                          IsReadOnly="True">
                                    <ComboBox.IsEnabled>
                                        <MultiBinding Converter="{StaticResource anyBoolToFalseConverter}">
                                            <Binding Path="QualifierCheck" />
                                            <Binding RelativeSource="{RelativeSource AncestorType={x:Type local:IonRatioItemsControl}}" Path="ReadOnlyMode" />
                                        </MultiBinding>
                                    </ComboBox.IsEnabled>
                                    <ComboBox.Text>
                                        <Binding Path="NewMass2" UpdateSourceTrigger="LostFocus">
                                            <Binding.ValidationRules>
                                                <Validators:MassValidationRule />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </ComboBox.Text>
                                    <ComboBox.ToolTip>
                                        <ToolTip>
                                            <ToolTip.Style>
                                                <Style TargetType="ToolTip">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=PlacementTarget.(Validation.HasError)}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Setter Property="Content" Value="{Binding RelativeSource={RelativeSource Self}, Path=PlacementTarget.(Validation.Errors)[0].ErrorContent}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToolTip.Style>
                                        </ToolTip>
                                    </ComboBox.ToolTip>
                                </ComboBox>
                                <TextBlock Grid.Column="4" Text="=" Style="{StaticResource HeaderStyleCentered}" />
                                <TextBox Grid.Column="5" Style="{StaticResource ValidatedTextBoxRightAligned}" IsReadOnly="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:IonRatioItemsControl}}, Path=ReadOnlyMode}">
                                    <TextBox.Text>
                                        <Binding Path="ExpectedRatio">
                                            <Binding.ValidationRules>
                                                <Validators:PercentValidationRule />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                                <TextBlock Grid.Column="6" Text="±" Style="{StaticResource HeaderStyleCentered}" />
                                <TextBox Grid.Column="7" Style="{StaticResource ValidatedTextBoxRightAligned}" IsReadOnly="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:IonRatioItemsControl}}, Path=ReadOnlyMode}">
                                    <TextBox.Text>
                                        <Binding Path="PercentTolerance">
                                            <Binding.ValidationRules>
                                                <Validators:PercentValidationRule />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                                <TextBlock Grid.Column="8" Text="%" Style="{StaticResource HeaderStyleCentered}" />
                                <TextBox Grid.Column="9" Text="{Binding Path=ActualRatio, Converter={StaticResource doubleToStringConverter}, 
                                    ConverterParameter=G4, Mode=OneWay}" 
                                         Style="{StaticResource ActualRatioTextBox}" IsReadOnly="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:IonRatioItemsControl}}, Path=ReadOnlyMode}" TextAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </Grid>
    </DataTemplate>

</ResourceDictionary>