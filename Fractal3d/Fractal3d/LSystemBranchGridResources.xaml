<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Fractal3d"
                    xmlns:basicWpfLibrary="clr-namespace:BasicWpfLibrary;assembly=BasicWpfLibrary">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="GeneralResources.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Grid x:Key="LSystemBranchGrid" Margin="2,5" Grid.IsSharedSizeScope="True" Visibility="{Binding LSystemVisibility}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- Header Row -->
            <RowDefinition Height="*"/>
            <!-- Items Rows -->
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource HeaderTextBlockStyle}" Text="L-system Branches" />
            <Button Margin="5,2" Padding="2" MinWidth="30" Command="{Binding AddBranchCommand}">Add</Button>
        </StackPanel>

        <Border Grid.Row="1" Background="#F0F0F0" Padding="2" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Column widths adjust dynamically, shared across all grids in this scope -->
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Pos"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Attenuation"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AngleX"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AngleY"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AngleZ"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Position" FontWeight="Bold" Margin="11,2"/>
                <TextBlock Grid.Column="1" Text="Attenuation" FontWeight="Bold" Margin="11,2"/>
                <TextBlock Grid.Column="2" Text="Angle X" FontWeight="Bold" Margin="11,2"/>
                <TextBlock Grid.Column="3" Text="Angle Y" FontWeight="Bold" Margin="11,2"/>
                <TextBlock Grid.Column="4" Text="Angle Z" FontWeight="Bold" Margin="11,2"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding LSystemBranches}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="2" BorderBrush="#EAEAEA" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Pos"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Attenuation"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="AngleX"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="AngleY"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="AngleZ"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource TextBoxInError}" Margin="11,2">
                                    <TextBox.Text>
                                        <Binding Path="RelativePositionX" UpdateSourceTrigger="LostFocus" >
                                            <Binding.ValidationRules>
                                                <basicWpfLibrary:FloatRangeRule Min="{x:Static local:ParameterConstants.MinLSystemRelativePosition }" 
                                                         Max="{x:Static local:ParameterConstants.MaxLSystemRelativePosition}"/>
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                                <TextBox Grid.Column="1" Style="{StaticResource TextBoxInError}" Margin="11,2">
                                    <TextBox.Text>
                                        <Binding Path="Attenuation" UpdateSourceTrigger="LostFocus" >
                                            <Binding.ValidationRules>
                                                <basicWpfLibrary:FloatRangeRule Min="{x:Static local:ParameterConstants.MinLSystemAttenuation }" 
                                                         Max="{x:Static local:ParameterConstants.MaxLSystemAttenuation}"/>
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                                <TextBox Grid.Column="2" Style="{StaticResource TextBoxInError}" Margin="11,2">
                                    <TextBox.Text>
                                        <Binding Path="AngleXDegrees" UpdateSourceTrigger="LostFocus" >
                                            <Binding.ValidationRules>
                                                <basicWpfLibrary:FloatRangeRule Min="{x:Static local:ParameterConstants.MinLSystemAngle }" 
                                                         Max="{x:Static local:ParameterConstants.MaxLSystemAngle}"/>
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                                <TextBox Grid.Column="3" Style="{StaticResource TextBoxInError}" Margin="11,2">
                                    <TextBox.Text>
                                        <Binding Path="AngleYDegrees" UpdateSourceTrigger="LostFocus" >
                                            <Binding.ValidationRules>
                                                <basicWpfLibrary:FloatRangeRule Min="{x:Static local:ParameterConstants.MinLSystemAngle }" 
                                                         Max="{x:Static local:ParameterConstants.MaxLSystemAngle}"/>
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                                <TextBox Grid.Column="4" Style="{StaticResource TextBoxInError}" Margin="11,2">
                                    <TextBox.Text>
                                        <Binding Path="AngleZDegrees" UpdateSourceTrigger="LostFocus" >
                                            <Binding.ValidationRules>
                                                <basicWpfLibrary:FloatRangeRule Min="{x:Static local:ParameterConstants.MinLSystemAngle }" 
                                                         Max="{x:Static local:ParameterConstants.MaxLSystemAngle}"/>
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                                <Button Grid.Column="5" Margin="11,2" Content="Delete" Command="{Binding DataContext.DeleteRowCommand, 
                                     RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</ResourceDictionary>