<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Fractal3d">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="GeneralResources.xaml"/>
    </ResourceDictionary.MergedDictionaries>


    <DataTemplate x:Key="FractalResultView" DataType="{x:Type local:FractalResultVm}" >
        <Border Style="{StaticResource BorderLightStyle}">
            <Expander Header="{Binding Path=Title}" HorizontalAlignment="Left" IsExpanded="False" ExpandDirection="Down">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <!-- 5 -->
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <!-- 10 -->
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <!-- 15 -->
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <!-- 19 L-System -->
                        <RowDefinition Height="Auto" />

                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource SmallTextBlockStyle}">Shader</TextBlock>
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource SmallTextBlockStyle}" Text="{Binding Path=ShaderName }"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource SmallTextBlockStyle}" 
                             Visibility="{Binding EquationVisibility}">Equation</TextBlock>
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource SmallTextBlockStyle}" 
                             Visibility="{Binding EquationVisibility}" Text="{Binding Path=EquationType }"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource SmallTextBlockStyle}"
                             Visibility="{Binding PaletteVisibility}">Palette</TextBlock>
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource SmallTextBlockStyle}"
                             Visibility="{Binding PaletteVisibility}" Text="{Binding Path=PaletteName }"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource SmallTextBlockStyle}"
                             Visibility="{Binding ConstantC_Visibility}">Const. C</TextBlock>
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource SmallTextBlockStyle}"
                             Visibility="{Binding ConstantC_Visibility}" Text="{Binding Path=ConstantC }"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource SmallTextBlockStyle}"
                             Visibility="{Binding IfsC_Visibility}">IFS C</TextBlock>
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource SmallTextBlockStyle}" 
                             Visibility="{Binding IfsC_Visibility}" Text="{Binding Path=IfsC }"/>
                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource SmallTextBlockStyle}"
                             Visibility="{Binding BailoutVisibility}" >Bailout</TextBlock>
                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource SmallTextBlockStyle}" 
                             Visibility="{Binding BailoutVisibility}" Text="{Binding Path=Bailout }"/>
                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource SmallTextBlockStyle}">X Range</TextBlock>
                    <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource SmallTextBlockStyle}" Text="{Binding Path=RangeX }"/>
                    <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource SmallTextBlockStyle}">Y Range</TextBlock>
                    <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource SmallTextBlockStyle}" Text="{Binding Path=RangeY }"/>
                    <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource SmallTextBlockStyle}">Z Range</TextBlock>
                    <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource SmallTextBlockStyle}" Text="{Binding Path=RangeZ }"/>
                    <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource SmallTextBlockStyle}">Aim to Origin</TextBlock>
                    <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource SmallTextBlockStyle}" Text="{Binding Path=AimToOrigin }"/>
                    <TextBlock Grid.Row="10" Grid.Column="0" Style="{StaticResource SmallTextBlockStyle}"
                             Visibility="{Binding IterationVisibility}">Iterations</TextBlock>
                    <TextBlock Grid.Row="10" Grid.Column="1" Style="{StaticResource SmallTextBlockStyle}" 
                             Visibility="{Binding IterationVisibility}" Text="{Binding Path=Iterations }"/>
                    <TextBlock Grid.Row="11" Grid.Column="0" Style="{StaticResource SmallTextBlockStyle}" Text="{Binding Path=MinRayDistance }"/>
                    <TextBlock Grid.Row="11" Grid.Column="1" Style="{StaticResource SmallTextBlockStyle}" Text="{Binding Path=MaxRaySteps }"/>
                    <TextBlock Grid.Row="12" Grid.Column="0" Style="{StaticResource SmallTextBlockStyle}" Text="{Binding Path=Distance }"/>
                    <TextBlock Grid.Row="12" Grid.Column="1" Style="{StaticResource SmallTextBlockStyle}" Text="{Binding Path=MaxDistance }"/>
                    <TextBlock Grid.Row="13" Grid.Column="0" Style="{StaticResource SmallTextBlockStyle}"
                             Visibility="{Binding StepDivisorVisibility}">Step Divisor</TextBlock>
                    <TextBlock Grid.Row="13" Grid.Column="1" Style="{StaticResource SmallTextBlockStyle}" 
                             Visibility="{Binding StepDivisorVisibility}" Text="{Binding Path=StepDivisor }"/>
                    <TextBlock Grid.Row="14" Grid.Column="0" Style="{StaticResource SmallTextBlockStyle}" 
                             Visibility="{Binding PaletteVisibility}">Lighting Zero:"</TextBlock>
                    <TextBlock Grid.Row="14" Grid.Column="1" Style="{StaticResource SmallTextBlockStyle}" 
                             Visibility="{Binding PaletteVisibility}" Text="{Binding Path=LightingOnZeroIndex }"/>
                    <TextBlock Grid.Row="15" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource SmallTextBlockStyle}"
                             Visibility="{Binding PaletteVisibility}" Text="{Binding Path=StretchDistanceRangeText}"/>
                    <TextBlock Grid.Row="16" Grid.Column="0" Style="{StaticResource SmallTextBlockStyle}" 
                             Visibility="{Binding IfsGeneral_Visibility}" Text="{Binding Path=IfsScale }"/>
                    <TextBlock Grid.Row="16" Grid.Column="1" Style="{StaticResource SmallTextBlockStyle}" 
                             Visibility="{Binding IfsGeneral_Visibility}" Text="{Binding Path=IfsAbs }"/>
                    <TextBlock Grid.Row="17" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource SmallTextBlockStyle}" 
                             Visibility="{Binding IfsGeneral_Visibility}" Text="{Binding Path=IfsRot1 }"/>
                    <TextBlock Grid.Row="18" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource SmallTextBlockStyle}" 
                             Visibility="{Binding IfsGeneral_Visibility}" Text="{Binding Path=IfsRot2 }"/>

                    <TextBlock Grid.Row="19" Grid.Column="0" Style="{StaticResource SmallTextBlockStyle}" 
                               Visibility="{Binding LsystemVisibility}" Text="{Binding Path=LsystemRadius }"/>
                    <TextBlock Grid.Row="19" Grid.Column="1" Style="{StaticResource SmallTextBlockStyle}" 
                               Visibility="{Binding LsystemVisibility}" Text="{Binding Path=LsystemAttenuation }"/>
                </Grid>
            </Expander>
        </Border>
    </DataTemplate>
    
</ResourceDictionary>